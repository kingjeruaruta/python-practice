# Grade Calculator
grade_math = float(input("Enter your Math grade          : "))
grade_filipino = float(input("Enter your Filipino grade  : "))
grade_science = float(input("Enter your Science grade    : "))    
grade_english = float(input("Enter your English grade    : "))    

average = (grade_math + grade_filipino + grade_science + grade_english) / 4

print(f"Your average grade is: {average:.2f}")

# Age Checker
age = int(input("Enter your age: "))
if age < 18:
    print("You are a minor.")
elif age >= 18 and age < 65:
    print("You are an adult.")
else:
    print("You are a senior citizen.")

